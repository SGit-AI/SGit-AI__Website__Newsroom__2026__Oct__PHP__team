    "capture": "20261022T080559Z",
    "sha256": "c88b8c5f4c6bc07d2ef85b78d0d66482f0322075621abb0631ef4352932aa97d"
   },
   "primary": {
    "text": "NCSC and NSA advise offline after mitigations; CERT-EU and CERT-FR advise isolation; ACSC gives no offline advice",
